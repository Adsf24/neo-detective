# Copy to .env and fill in. Never commit .env.
LLAMA_API_KEY=
PORT=3000
# Optional overrides for the Meta Model API (OpenAI-compatible endpoint).
# LLAMA_BASE_URL=https://api.meta.ai/v1
# LLAMA_MODEL_FAST=muse-spark-1.1
# LLAMA_MODEL_STRONG=muse-spark-1.3
# LLAMA_REASONING_EFFORT=minimal
# Force the offline provider even when a key is set:
# LLM_PROVIDER=scripted

# Character voices (ElevenLabs). May also live in .env.local. Without a key the
# browser's own speech synthesis is used.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4_turbo
# TTS_PROVIDER=off
# LIMIT_TTS_CHARS_PER_ROOM=9000
